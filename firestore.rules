rules_version = '2';

// Mis Ventas — RF 7.1 / RNF de seguridad.
// Cada vendedor solo puede leer y escribir su propia información: usuarios/{uid}/...
// Todo lo demás queda cerrado.
service cloud.firestore {
  match /databases/{database}/documents {
    match /usuarios/{uid}/{documento=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
